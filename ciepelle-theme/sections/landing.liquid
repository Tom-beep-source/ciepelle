          <tr><td>Wysoki, wygładzający stan</td><td class="yes">✓</td><td class="no">✕</td><td class="no">✕</td></tr>
          <tr><td>Miękki polar od środka</td><td class="yes">✓</td><td class="no">✕</td><td class="yes">✓</td></tr>
