<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#7A2944">
    <link rel="icon" type="image/svg+xml" href="{{ 'ciepelle-favicon.svg' | asset_url }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- capture seo_title -%}
      {%- if template.name == 'index' -%}Ciepelle – rajstopy ocieplane polarem z efektem nagich nóg
      {%- else -%}{{ page_title }}{% if current_page != 1 %} – strona {{ current_page }}{% endif %}{% unless page_title contains 'Ciepelle' %} | Ciepelle{% endunless %}{%- endif -%}
    {%- endcapture -%}
    <title>{{ seo_title | strip }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="Ciepłe rajstopy z puszystym polarem 220 g, które wyglądają jak cienkie cieliste rajstopy. 3 kolory, darmowa dostawa w całej Polsce, 14 dni na zwrot.">
    {%- endif -%}

    <meta property="og:site_name" content="Ciepelle">
    <meta property="og:title" content="{{ seo_title | strip | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if page_image -%}
      <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700;800&display=swap&subset=latin-ext" rel="stylesheet">

    {{ 'ciepelle.css' | asset_url | stylesheet_tag }}
    {{ 'ciepelle-extra.css' | asset_url | stylesheet_tag }}
    {{ 'ciepelle-typo.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>

  <body class="tpl-{{ template.name }}">
    <a class="skip-link" href="#main">Przejdź do treści</a>
    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'ciepelle.js' | asset_url }}" defer></script>
    <script src="{{ 'ciepelle-typo.js' | asset_url }}" defer></script>
    <script src="{{ 'ciepelle-xl.js' | asset_url }}" defer></script>
    {%- comment -%} v44 : pop-up selfie retiré du panier (il masquait le bouton de paiement). L'offre selfie -10 % est dans l'e-mail d'expédition. {%- endcomment -%}
  </body>
</html>
