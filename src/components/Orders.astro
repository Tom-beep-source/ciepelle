---
import { siteConfig } from "../config";

// Rien à afficher si le commerce ne propose pas de commandes à l'avance —
// voir NOUVEAU-CLIENT.md §4 ter.
const { commandes } = siteConfig;
---

{commandes && (
  <section id="orders" class="wrap section-padding border-t border-black/5">
    <div class="max-w-2xl" data-reveal>
      <h2 class="text-section-title font-heading text-ink">{commandes.title}</h2>
      <p class="mt-4 text-body text-ink/70">{commandes.intro}</p>
    </div>

    <ul data-reveal-group class="mt-10 max-w-2xl divide-y divide-black/10">
      {commandes.items.map((item) => (
        <li class="py-4">
          <p class="menu-item-name">{item.label}</p>
          <p class="mt-1 text-sm text-ink/70">
            Délai minimum : {item.delaiMinimum}
            {item.quantiteMinimum && <> · Quantité minimale : {item.quantiteMinimum}</>}
          </p>
        </li>
      ))}
    </ul>

    {commandes.noteForteDemande && (
      <p class="mt-6 max-w-2xl text-sm italic text-ink/70" data-reveal>{commandes.noteForteDemande}</p>
    )}

    <a
      href={`tel:${siteConfig.contact.phoneHref}`}
      class="mt-10 inline-flex w-full items-center justify-center rounded-full bg-primary px-7 py-3.5 text-base font-semibold text-white transition-opacity hover:opacity-90 sm:w-auto"
      data-reveal
    >
      Appeler pour commander
    </a>

    <p class="mt-6 max-w-2xl text-body text-ink/70" data-reveal>
      Ou envoyez votre demande ci-dessous :
    </p>

    <form
      id="order-form"
      data-reveal
      class="mt-4 max-w-xl space-y-4 rounded-2xl border border-black/10 p-6 sm:p-8"
    >
      <input type="hidden" name="access_key" value={siteConfig.forms.web3formsAccessKey} />
      <input type="hidden" name="subject" value={`Nouvelle demande de commande depuis le site ${siteConfig.business.name}`} />
      <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />

      <div>
        <label for="order-name" class="mb-1.5 block text-base font-medium text-ink">Nom</label>
        <input
          id="order-name"
          name="name"
          type="text"
          required
          class="w-full rounded-lg border border-black/10 bg-surface px-4 py-2.5 text-ink outline-none focus:border-primary"
        />
      </div>

      <div>
        <label for="order-phone" class="mb-1.5 block text-base font-medium text-ink">Téléphone</label>
        <input
          id="order-phone"
          name="phone"
          type="tel"
          required
          class="w-full rounded-lg border border-black/10 bg-surface px-4 py-2.5 text-ink outline-none focus:border-primary"
        />
      </div>

      <div>
        <label for="order-product" class="mb-1.5 block text-base font-medium text-ink">Produit</label>
        <input
          id="order-product"
          name="product"
          type="text"
          list="order-product-options"
          required
          class="w-full rounded-lg border border-black/10 bg-surface px-4 py-2.5 text-ink outline-none focus:border-primary"
        />
        <datalist id="order-product-options">
          {commandes.items.map((item) => <option value={item.label} />)}
        </datalist>
      </div>

      <div>
        <label for="order-quantity" class="mb-1.5 block text-base font-medium text-ink">Quantité</label>
        <input
          id="order-quantity"
          name="quantity"
          type="number"
          min="1"
          required
          class="w-full rounded-lg border border-black/10 bg-surface px-4 py-2.5 text-ink outline-none focus:border-primary"
        />
      </div>

      <div>
        <label for="order-date" class="mb-1.5 block text-base font-medium text-ink">Date de retrait souhaitée</label>
        <input
          id="order-date"
          name="pickup_date"
          type="date"
          required
          class="w-full rounded-lg border border-black/10 bg-surface px-4 py-2.5 text-ink outline-none focus:border-primary"
        />
      </div>

      <div>
        <label for="order-notes" class="mb-1.5 block text-base font-medium text-ink">Remarques</label>
        <textarea
          id="order-notes"
          name="notes"
          rows="3"
          class="w-full rounded-lg border border-black/10 bg-surface px-4 py-2.5 text-ink outline-none focus:border-primary"
        ></textarea>
      </div>

      <button
        type="submit"
        class="w-full rounded-full bg-primary px-7 py-3.5 text-base font-semibold text-white transition-opacity hover:opacity-90 sm:w-auto"
      >
        Envoyer la demande
      </button>

      <p id="order-form-status" class="text-sm" role="status"></p>

      <p class="text-sm text-ink/70">
        Cette demande n'est pas une commande confirmée : nous vous rappelons pour valider ensemble le délai et les modalités de retrait.
      </p>
    </form>
  </section>
)}

<script>
  const form = document.getElementById("order-form") as HTMLFormElement | null;
  const status = document.getElementById("order-form-status");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!status) return;

    const submitButton = form.querySelector("button[type=submit]") as HTMLButtonElement | null;
    if (submitButton) submitButton.disabled = true;
    status.textContent = "Envoi en cours…";
    status.className = "text-sm text-ink/70";

    try {
      const response = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        headers: { Accept: "application/json" },
        body: new FormData(form),
      });
      const result = await response.json();

      if (result.success) {
        status.textContent = "Demande envoyée, merci ! Nous vous rappelons pour confirmer.";
        status.className = "text-sm text-green-700";
        form.reset();
      } else {
        throw new Error(result.message ?? "Erreur inconnue");
      }
    } catch {
      status.textContent = "Une erreur est survenue, réessayez ou appelez-nous directement.";
      status.className = "text-sm text-red-600";
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
