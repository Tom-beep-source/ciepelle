---
import { siteConfig, type PracticalItem } from "../config";

// Pictogrammes line-art (trait 1.5, même grille 24px) pour rester cohérent
// avec le reste du site : pas d'aplats, pas de blocs colorés.
const ICONS: Record<PracticalItem["icon"], string> = {
  bag: '<path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  coffee:
    '<path d="M3 8h13v6a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8Z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M7 3v2M11.5 3v2"/><path d="M2.5 21h15"/>',
  sunrise:
    '<path d="M12 3v3"/><path d="M5.6 8.6 7.4 10.4"/><path d="M18.4 8.6 16.6 10.4"/><path d="M7.5 16a4.5 4.5 0 0 1 9 0"/><path d="M3 16h18"/><path d="M6 20h12"/>',
  clock: '<circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 2.5"/>',
  wheelchair:
    '<circle cx="13.5" cy="4" r="2"/><path d="M12.5 7v5.5H17"/><path d="M17 12.5 19.5 19"/><circle cx="10.5" cy="15" r="6"/>',
  parking:
    '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M10 16V8h2.8a2.6 2.6 0 0 1 0 5.2H10"/>',
  card: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/><path d="M7 15h3"/>',
  nfc: '<path d="M8 7a7 7 0 0 1 0 10"/><path d="M11.5 5a11 11 0 0 1 0 14"/><path d="M4.5 9.5a3.5 3.5 0 0 1 0 5"/>',
  ticket:
    '<path d="M4 8a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4V8Z"/><path d="M14 8v8"/>',
};

const columns = [
  { title: "Services", items: siteConfig.practical.services },
  { title: "Accessibilité", items: siteConfig.practical.accessibility },
  { title: "Paiements", items: siteConfig.practical.payments },
];
---

<section id="practical" class="wrap section-padding border-t border-black/5">
  <h2 class="text-section-title font-heading text-ink" data-reveal>
    Infos pratiques
  </h2>

  <div data-reveal-group class="mt-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-14">
    {columns.map((column) => (
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-ink/70">
          {column.title}
        </h3>
        <ul class="mt-5 space-y-4">
          {column.items.map((item) => (
            <li class="flex items-start gap-3">
              <svg
                class:list={[
                  "mt-0.5 h-5 w-5 shrink-0",
                  item.highlight ? "text-primary" : "text-secondary/70",
                ]}
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={ICONS[item.icon]}
              />
              <span
                class:list={[
                  "text-body",
                  item.highlight ? "font-semibold text-ink" : "text-ink/75",
                ]}
              >
                {item.label}
              </span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
