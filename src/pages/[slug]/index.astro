---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import StickyMobileBar from "../../components/StickyMobileBar.astro";
import { siteConfig } from "../../config";

// Route unique, dérivée de siteConfig.infoPage.slug — pas une page dynamique
// générique : getStaticPaths ne construit que ce seul chemin.
export function getStaticPaths() {
  return [{ params: { slug: siteConfig.infoPage.slug } }];
}

const { business, menu, allergenesValides, infoPage } = siteConfig;
---

<BaseLayout
  title={`${infoPage.title} — ${business.name}`}
  description={`Détail des produits (ingrédients, allergènes et autres informations) pour chaque article de ${business.name}.`}
>
  <Header />
  <main>
    <section class="wrap section-padding max-w-3xl">
      <h1 class="text-section-title font-heading text-ink" data-reveal>{infoPage.title}</h1>

      {!allergenesValides && (
        <div class="mt-6 rounded-lg bg-primary px-5 py-4 text-white" data-reveal>
          <p class="font-semibold">
            EXEMPLE — données non validées par le commerce, à titre de démonstration.
          </p>
        </div>
      )}

      <p class="mt-6 text-body text-ink/80" data-reveal>{infoPage.intro}</p>

      <div class="mt-16 space-y-16">
        {menu.map((category) => (
          <div>
            <h2 class="text-category-title font-heading text-ink" data-reveal>{category.category}</h2>
            <ul class="mt-8 divide-y divide-black/10" data-reveal-group>
              {category.items.map((item) => (
                <li class="py-6">
                  <p class="menu-item-name">{item.name}</p>
                  {item.ingredients && item.ingredients.length > 0 && (
                    <p class="mt-1.5 text-body text-ink/70">
                      <span class="font-medium text-ink">Ingrédients :</span>{" "}
                      {item.ingredients.join(", ")}
                    </p>
                  )}
                  {item.allergenes && (
                    <p class="mt-1.5 text-body text-ink/70">
                      <span class="font-medium text-ink">Allergènes :</span>{" "}
                      {item.allergenes.length > 0
                        ? item.allergenes.join(", ")
                        : "Aucun des 14 allergènes à déclaration obligatoire"}
                    </p>
                  )}
                  {item.details?.map((detail) => (
                    <p class="mt-1.5 text-body text-ink/70">
                      <span class="font-medium text-ink">{detail.label} :</span> {detail.value}
                    </p>
                  ))}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
  <StickyMobileBar />
</BaseLayout>
