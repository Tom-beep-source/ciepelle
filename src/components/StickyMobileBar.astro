---
import { siteConfig, getDirectionsUrl } from "../config";

const directionsUrl = getDirectionsUrl();
---

{/* <nav> plutôt qu'un <div> : sans repère, le contenu échappe à la navigation
    par landmarks des lecteurs d'écran (règle axe « region »). */}
<nav
  aria-label="Actions rapides"
  class="fixed inset-x-0 bottom-0 z-50 flex border-t border-black/10 bg-surface shadow-[0_-4px_12px_rgba(0,0,0,0.08)] md:hidden"
  style="padding-bottom: env(safe-area-inset-bottom);"
>
  <a
    href={`tel:${siteConfig.contact.phoneHref}`}
    class="flex flex-1 items-center justify-center gap-2 border-r border-black/10 py-4 text-base font-semibold text-ink"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    Appeler
  </a>
  <a
    href={directionsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="flex flex-1 items-center justify-center gap-2 bg-primary py-4 text-base font-semibold text-white"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
    </svg>
    Itinéraire
  </a>
</nav>

<!-- Espace réservé en bas de page mobile pour ne pas masquer le contenu sous la barre sticky -->
<div class="h-16 md:hidden" aria-hidden="true"></div>
