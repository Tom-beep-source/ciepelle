---
import { siteConfig } from "../config";
---

<section id="testimonials" class="wrap section-padding border-t border-black/5">
  <h2 class="text-section-title font-heading text-ink" data-reveal>
    Ce qu'ils en disent
  </h2>

  <div data-reveal-group class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {siteConfig.testimonials.map((testimonial) => (
      <figure class="rounded-2xl border border-black/10 p-6">
        <svg
          class="mb-4 h-6 w-6 text-accent"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M7.5 6C5 6 3 8 3 10.5S5 15 7.5 15c.3 0 .6 0 .9-.1-.6 1.7-2 3-3.7 3.5v2.1c3.6-.7 6.3-3.9 6.3-7.7V10.5C11 8 9 6 7.5 6zm9 0C14 6 12 8 12 10.5S14 15 16.5 15c.3 0 .6 0 .9-.1-.6 1.7-2 3-3.7 3.5v2.1c3.6-.7 6.3-3.9 6.3-7.7V10.5C20 8 18 6 16.5 6z" />
        </svg>
        <blockquote class="text-body leading-relaxed text-ink/80">
          {testimonial.text}
        </blockquote>
        <figcaption class="mt-4 text-base font-medium text-ink">
          {testimonial.name}
        </figcaption>
      </figure>
    ))}
  </div>

  {siteConfig.googleReviewsUrl && (
    <a
      href={siteConfig.googleReviewsUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-reveal
      class="mt-8 inline-flex items-center gap-2 text-base font-medium text-primary underline underline-offset-4 hover:no-underline"
    >
      Voir les avis Google
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5h5v5m0-5L10 14M19 14v5H5V5h5" />
      </svg>
    </a>
  )}
</section>
