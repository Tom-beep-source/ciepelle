{% comment %}
  Premium blog listing page for Ciepelle.
{% endcomment %}

<div class="blog-page">

  <div class="blog-page__hero animate-in">
    <span class="blog-page__label">Blog Ciepelle</span>
    <h1 class="blog-page__title">{{ blog.title }}</h1>
    <p class="blog-page__sub">Expert tips, climbing guides, and everything you need to keep your cat happy and active.</p>
  </div>

  {%- paginate blog.articles by 9 -%}

    {%- if blog.articles_count > 0 -%}

      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <article class="blog-card animate-in animate-in--d{{ forloop.index | modulo: 3 | plus: 1 }}">
            <a href="{{ article.url }}" class="blog-card__img-link">
              <div class="blog-card__img-wrap">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 800, height: 500, crop: 'center' | image_tag: class: 'blog-card__img', loading: 'lazy', alt: article.title }}
                {%- else -%}
                  <div class="blog-card__img-placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#D4A574" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 21V9"/>
                    </svg>
                  </div>
                {%- endif -%}
                {%- if article.tags.size > 0 -%}
                  <span class="blog-card__tag">{{ article.tags | first }}</span>
                {%- endif -%}
              </div>
            </a>
            <div class="blog-card__body">
              <div class="blog-card__meta">
                {%- assign date = article.published_at | time_tag: format: 'date' -%}
                <span class="blog-card__date">{{ date }}</span>
                <span class="blog-card__author">by {{ article.author }}</span>
              </div>
              <h2 class="blog-card__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>
              {%- if article.excerpt != blank -%}
                <p class="blog-card__excerpt">{{ article.excerpt | strip_html | truncatewords: 22 }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="blog-card__read-more">Read article →</a>
            </div>
          </article>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="blog-pagination">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}

    {%- else -%}

      <div class="blog-empty animate-in">
        <span class="blog-empty__icon">📖</span>
        <h2>Articles coming soon</h2>
        <p>We're working on expert guides to help your cat thrive. Check back soon!</p>
        <a href="{{ routes.all_products_collection_url }}" class="blog-empty__btn">Browse our cat trees</a>
      </div>

    {%- endif -%}

  {%- endpaginate -%}

</div>

{% stylesheet %}
  .blog-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 24px 80px;
  }

  /* HERO */
  .blog-page__hero {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 60px;
  }
  .blog-page__label {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8B5E3C;
    background: #F5EBD8;
    padding: 6px 16px;
    border-radius: 100px;
    margin-bottom: 20px;
  }
  .blog-page__title {
    font-size: 2.6rem;
    font-weight: 900;
    color: #2A1408;
    margin: 0 0 16px;
    line-height: 1.15;
  }
  .blog-page__sub {
    color: #5C3318;
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0;
  }

  /* GRID */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
    margin-bottom: 56px;
  }

  /* CARD */
  .blog-card {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid #EDD5B0;
    background: white;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s cubic-bezier(0.22, 1, 0.36, 1);
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 44px rgba(139, 94, 60, 0.12);
  }
  .blog-card__img-link {
    display: block;
    text-decoration: none;
  }
  .blog-card__img-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #F5EBD8;
  }
  .blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .blog-card:hover .blog-card__img {
    transform: scale(1.05);
  }
  .blog-card__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F5EBD8;
  }
  .blog-card__tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgba(139, 94, 60, 0.9);
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
  }
  .blog-card__body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }
  .blog-card__date {
    font-size: 0.78rem;
    color: #C4A882;
  }
  .blog-card__author {
    font-size: 0.78rem;
    color: #C4A882;
  }
  .blog-card__date::after {
    content: '·';
    margin-left: 10px;
  }
  .blog-card__title {
    font-size: 1rem;
    font-weight: 700;
    color: #2A1408;
    margin: 0 0 10px;
    line-height: 1.45;
    flex: 1;
  }
  .blog-card__title a {
    text-decoration: none;
    color: inherit;
    transition: color 0.18s;
  }
  .blog-card__title a:hover {
    color: #8B5E3C;
  }
  .blog-card__excerpt {
    font-size: 0.85rem;
    color: #8B7355;
    line-height: 1.6;
    margin: 0 0 16px;
  }
  .blog-card__read-more {
    font-size: 0.84rem;
    font-weight: 700;
    color: #8B5E3C;
    text-decoration: none;
    transition: gap 0.18s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: auto;
  }
  .blog-card__read-more:hover {
    text-decoration: underline;
  }

  /* EMPTY */
  .blog-empty {
    text-align: center;
    padding: 80px 24px;
  }
  .blog-empty__icon {
    font-size: 3.5rem;
    display: block;
    margin-bottom: 20px;
  }
  .blog-empty h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #2A1408;
    margin: 0 0 10px;
  }
  .blog-empty p {
    color: #8B7355;
    margin: 0 0 28px;
  }
  .blog-empty__btn {
    display: inline-block;
    padding: 14px 28px;
    background: linear-gradient(135deg, #8B5E3C, #6B4227);
    color: white;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    box-shadow: 0 4px 16px rgba(139, 94, 60, 0.3);
    transition: all 0.2s;
  }
  .blog-empty__btn:hover {
    transform: translateY(-2px);
    color: white;
  }

  /* PAGINATION */
  .blog-pagination {
    display: flex;
    justify-content: center;
    margin-top: 48px;
  }
  .blog-pagination a,
  .blog-pagination span {
    padding: 10px 16px;
    border: 1px solid #EDD5B0;
    border-radius: 8px;
    margin: 0 4px;
    text-decoration: none;
    color: #4A3728;
    font-weight: 600;
    transition: all 0.18s;
  }
  .blog-pagination a:hover,
  .blog-pagination .current {
    background: #8B5E3C;
    color: white;
    border-color: #8B5E3C;
  }

  /* RESPONSIVE */
  @media (max-width: 960px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .blog-page__title {
      font-size: 1.8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
